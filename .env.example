# Copy to .env — the app runs fully in Demo Mode with no keys configured.
DATABASE_URL="file:./dev.db"
DEMO_MODE="true"

ANTHROPIC_API_KEY=""
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
EBAY_MARKETPLACE_ID="EBAY_US"
EBAY_ENV="sandbox"
EBAY_INSIGHTS_ENABLED="false"

# Shipping estimator (lib/shipping/) — free to quote, needs a registered
# account at easyparcel.my. Without a key the app falls back to clearly
# labeled DEMO courier rates; chargeable-weight math always works either way.
EASYPARCEL_API_KEY=""
SHIP_FROM_POSTCODE=""
